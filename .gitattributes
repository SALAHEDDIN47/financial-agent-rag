# ===============================
# 1. NORMALISATION DES FINS DE LIGNE
# ===============================
# Auto-détection globale : convertit en LF à l'ajout, et en LF localement
* text=auto

# Scripts shell et fichiers Linux doivent impérativement rester en LF
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.fish text eol=lf

# Fichiers Windows Batch en CRLF (si jamais)
*.bat text eol=crlf
*.cmd text eol=crlf

# ===============================
# 2. FICHIERS DE CONFIGURATION / YAML / JSON / TOML
# ===============================
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.cfg text eol=lf

# Dockerfile (pas d'extension)
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
*.dockerfile text eol=lf

# ===============================
# 3. SCRIPTS PYTHON & CODE
# ===============================
*.py text eol=lf diff=python
*.pyx text eol=lf
*.pxd text eol=lf
*.pxi text eol=lf

# Fichiers de données texte courants
*.csv text eol=lf
*.tsv text eol=lf
*.txt text eol=lf
*.md text eol=lf diff=markdown
*.rst text eol=lf

# ===============================
# 4. NOTEBOOKS JUPYTER (.ipynb)
# ===============================
# On les traite en texte, mais on force LF et on active le diff spécifique
*.ipynb text eol=lf diff=ipynb

# Si tu as l'outil nbdime (recommandé), décommente la ligne suivante :
# *.ipynb diff=nbdime

# ===============================
# 5. FICHIERS BINAIRES (ON INTERDIT LE DIFF)
# ===============================
# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary

# Documents compressés
*.zip binary
*.tar.gz binary
*.tgz binary
*.gz binary
*.bz2 binary
*.7z binary
*.rar binary

# Fichiers de données binaires
*.parquet binary
*.feather binary
*.arrow binary
*.lmdb binary
*.sqlite binary
*.sqlite3 binary
*.db binary

# Fichiers de modèles ML / LLM
*.pb binary
*.h5 binary
*.hdf5 binary
*.onnx binary
*.tflite binary
*.pth binary
*.pt binary
*.bin binary
*.safetensors binary

# ===============================
# 6. GIT LFS (LARGE FILE STORAGE) - RECOMMANDÉ POUR CE PROJET
# ===============================
# ⚠️ Nécessite d'installer Git LFS : https://git-lfs.com
# Puis exécuter : git lfs install
# Les gros fichiers seront stockés sur GitHub LFS (ou GitLab LFS) au lieu du dépôt

# PDFs (les 10-K font souvent plusieurs Mo)
*.pdf filter=lfs diff=lfs merge=lfs -text

# Fichiers vidéo / audio
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text

# Modèles LLM (Llama, Mistral, etc.) – souvent > 1 Go
*.gguf filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text

# Grosses bases de données ou datasets
*.parquet filter=lfs diff=lfs merge=lfs -text
*.feather filter=lfs diff=lfs merge=lfs -text
*.arrow filter=lfs diff=lfs merge=lfs -text
*.csv filter=lfs diff=lfs merge=lfs -text  # Si tes CSV font plusieurs centaines de Mo

# Archives volumineuses
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text

# ===============================
# 7. INDICATEURS LINGUISTIQUES POUR GITHUB
# ===============================
# Permet à GitHub de bien classifier les notebooks Python
*.ipynb linguist-language=Jupyter Notebook

# Ignorer certains dossiers dans les stats de langage (optionnel)
# data/** linguist-vendored
# notebooks/** linguist-vendored