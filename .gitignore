# ===============================
# 3. DONNÉES DU PROJET (VOLUMINEUX / INDISPENSABLES)
# ===============================
# Tous les fichiers bruts, traités et tables extraites
# ⚠️  Si tu veux conserver la structure des dossiers (mais pas les fichiers),
#     tu peux commenter les lignes ci-dessous et ajouter des fichiers .gitkeep
#     dans chaque dossier manuellement.
data/raw/
data/processed/
data/tables/
data/elasticsearch/
data/etcd/
data/milvus/
data/minio/
data/minio-milvus/

# Mais si tu souhaites juste ignorer tout le contenu de data/ sauf un .gitkeep :
# data/*
# !data/.gitkeep

# Journaux de données spécifiques
*.log
*.parquet
*.feather
*.arrow
*.lmdb
*.sqlite
*.sqlite3
*.db

