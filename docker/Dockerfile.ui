# docker/Dockerfile.ui
FROM financial-agent-rag-base AS ui

COPY src/ ./src/
COPY README.md ./
RUN uv sync --frozen --no-dev

EXPOSE 8501

CMD ["uv", "run", "streamlit", "run", "src/ui/streamlit_app.py", \
     "--server.address", "0.0.0.0", \
     "--server.port", "8501", \
     "--server.headless", "true"]